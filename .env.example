# INA.EXE Transmission Terminal Environment Configuration
# All variables are optional; the application includes built-in fallbacks.

# Option 1: Custom backend API endpoint (e.g. your serverless /api/transmission or self-hosted endpoint)
# VITE_TRANSMISSION_API_URL=/api/transmission

# Option 2: Formspree Form ID (e.g. https://formspree.io/f/your_form_id)
# VITE_FORMSPREE_ID=

# Option 3: Web3Forms Access Key (from https://web3forms.com)
# VITE_WEB3FORMS_ACCESS_KEY=

# Option 4 (Server-side Vercel Environment Variables - NEVER expose in client):
# RESEND_API_KEY=re_123456789
# CONTACT_EMAIL=inagracetan@gmail.com

